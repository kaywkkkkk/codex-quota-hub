<Window x:Class="CodexQuotaHub.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_SettingsTitle}" Width="560" Height="540"
        MinWidth="540" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource Brush0D1117}"
        Foreground="{DynamicResource BrushE6EDF3}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush17212C}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushE6EDF3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush30404E}" />
            <Setter Property="CaretBrush" Value="{DynamicResource BrushE6EDF3}" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Height" Value="29" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource Brush17212C}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushE6EDF3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush30404E}" />
            <Setter Property="CaretBrush" Value="{DynamicResource BrushE6EDF3}" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Height" Value="29" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Brush17212C}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushE6EDF3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush30404E}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SelectedSurface"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Path Data="M 0 0 L 8 0 L 4 4 Z" Width="8" Height="4"
                                                  Fill="{DynamicResource Brush9FB0BF}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectedSurface" Property="BorderBrush"
                                                        Value="{DynamicResource Brush48C5A9}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="SelectedSurface" Property="BorderBrush"
                                                        Value="{DynamicResource Brush48C5A9}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelectionText"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              IsHitTestVisible="False" VerticalAlignment="Center"
                                              Margin="11,0,29,0" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownSurface" MinWidth="{TemplateBinding ActualWidth}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="2">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Brush17212C}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushE6EDF3}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background"
                                        Value="{DynamicResource Brush2B3A49}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background"
                                        Value="{DynamicResource Brush153029}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource L_SettingsTitle}" FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,18" />
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource L_IntervalLabel}" VerticalAlignment="Center" />
            <ComboBox x:Name="IntervalChoice" Grid.Column="1">
                <ComboBoxItem Content="{DynamicResource L_Interval60}" Tag="60" />
                <ComboBoxItem Content="{DynamicResource L_Interval300}" Tag="300" />
                <ComboBoxItem Content="{DynamicResource L_Interval900}" Tag="900" />
            </ComboBox>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource L_ThemeLabel}" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeChoice" Grid.Column="1">
                <ComboBoxItem Content="{DynamicResource L_Dark}" Tag="dark" />
                <ComboBoxItem Content="{DynamicResource L_Light}" Tag="light" />
            </ComboBox>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource L_LanguageLabel}" VerticalAlignment="Center" />
            <ComboBox x:Name="LanguageChoice" Grid.Column="1">
                <ComboBoxItem Content="{DynamicResource L_TraditionalChinese}" Tag="zh-TW" />
                <ComboBoxItem Content="{DynamicResource L_English}" Tag="en" />
                <ComboBoxItem Content="{DynamicResource L_SimplifiedChinese}" Tag="zh-CN" />
            </ComboBox>
        </Grid>
        <TextBlock Grid.Row="4" Text="{DynamicResource L_IntervalHint}"
                   Foreground="{DynamicResource Brush8293A3}" TextWrapping="Wrap"
                   FontSize="11" Margin="0,0,0,16" />
        <Border Grid.Row="5" Height="1" Background="{DynamicResource Brush30404E}"
                Margin="0,0,0,13" />
        <CheckBox x:Name="TelegramEnabled" Grid.Row="6"
                  Content="{DynamicResource L_TelegramEnable}" Margin="0,0,0,12" />
        <Grid Grid.Row="7" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource L_TelegramBotToken}" VerticalAlignment="Center" />
            <PasswordBox x:Name="TelegramBotToken" Grid.Column="1"
                         ToolTip="{DynamicResource L_TelegramTokenHint}" />
        </Grid>
        <Grid Grid.Row="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource L_TelegramChatId}" VerticalAlignment="Center" />
            <TextBox x:Name="TelegramChatId" Grid.Column="1" />
        </Grid>
        <TextBlock x:Name="LookupInstruction" Grid.Row="9" FontSize="11"
                   Foreground="{DynamicResource Brush8293A3}" TextWrapping="Wrap"
                   Margin="0,0,0,8" />
        <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="FindChatButton" Content="{DynamicResource L_TelegramFindChat}"
                    Padding="10,5" Margin="0,0,8,0" Click="FindChat_Click" />
            <Button x:Name="TestTelegramButton" Content="{DynamicResource L_TelegramTest}"
                    Padding="10,5" Margin="0,0,8,0" Click="TestTelegram_Click" />
            <Button Content="{DynamicResource L_TelegramClear}"
                    Padding="10,5" Click="ClearTelegram_Click" />
        </StackPanel>
        <TextBlock x:Name="TelegramStatus" Grid.Row="11" FontSize="11"
                   Foreground="{DynamicResource Brush73D8C2}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource L_Cancel}" Background="{DynamicResource Brush34495C}"
                    Foreground="{DynamicResource SecondaryButtonText}"
                    Width="70" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="SaveButton" Content="{DynamicResource L_Save}" Width="70" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
