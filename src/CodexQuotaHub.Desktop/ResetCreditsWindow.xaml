<Window x:Class="CodexQuotaHub.Desktop.ResetCreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_CreditTitle}" Width="540" Height="500" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush0D1117}" Foreground="{DynamicResource BrushE6EDF3}"
        ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="CreditTemplate">
            <Border Background="{DynamicResource Brush17212C}" BorderBrush="{DynamicResource Brush30404E}" BorderThickness="1"
                    CornerRadius="10" Padding="14,12" Margin="0,0,0,9">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   FontSize="11" Foreground="{DynamicResource Brush73D8C2}" Margin="10,2,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource BrushA9B7C5}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding ExpirationText}" Foreground="{DynamicResource BrushE6EDF3}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource L_CreditTitle}" FontSize="21" FontWeight="Bold" />
            <TextBlock x:Name="CountText" Grid.Column="1" FontSize="16"
                       Foreground="{DynamicResource Brush73D8C2}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,10,0,17">
            <TextBlock x:Name="AccountText" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="UpdatedText" FontSize="11" Foreground="{DynamicResource Brush8293A3}"
                       Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource Brush153029}" CornerRadius="8"
                Padding="12,9" Margin="0,0,0,14">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CreditList" ItemTemplate="{StaticResource CreditTemplate}" />
        </ScrollViewer>
        <Button Grid.Row="4" Content="{DynamicResource L_Close}" Width="70" Height="28"
                HorizontalAlignment="Right" Margin="0,15,0,0" Click="CloseButton_Click"
                Background="{DynamicResource Brush34495C}" Foreground="{DynamicResource SecondaryButtonText}" BorderThickness="0"
                Cursor="Hand" />
    </Grid>
</Window>
