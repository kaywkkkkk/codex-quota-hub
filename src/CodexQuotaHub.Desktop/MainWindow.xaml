<Window x:Class="CodexQuotaHub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota Hub" Width="980" Height="740" MinWidth="650" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush0D1117}" Foreground="{DynamicResource BrushE6EDF3}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush238B73}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AvailabilityBarStyle" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="{DynamicResource Brush30404E}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                    CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="0">
                                <Setter TargetName="PART_Track" Property="Background" Value="{DynamicResource Brush40292E}" />
                                <Setter TargetName="PART_Track" Property="BorderBrush" Value="{DynamicResource BrushE36B6B}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush20323B}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushE6EDF3}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush5B746F}"
                                BorderThickness="1" CornerRadius="7" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResetCreditButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BrushE6EDF3}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="WindowTemplate">
            <Border Background="{DynamicResource Brush17212C}" CornerRadius="10" Padding="12,7" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" ToolTip="{Binding Source.LimitId}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResetText}" Foreground="{DynamicResource Brush9FB0BF}" FontSize="11" />
                        <TextBlock Text="{Binding CountdownText}" Foreground="{DynamicResource Brush73D8C2}" FontSize="11" Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CountdownText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource AvailabilityBarStyle}"
                                     Value="{Binding AvailablePercent, Mode=OneWay}"
                                     Foreground="{Binding AvailabilityBrush}" Width="145" Height="7"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AvailableText}" Foreground="{Binding AvailabilityBrush}"
                                   FontSize="16" FontWeight="Bold" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DailyTokenAccountTemplate">
            <Border Background="{DynamicResource Brush17212C}" CornerRadius="7" Padding="7,6" Margin="0,0,5,0"
                    ToolTip="{Binding TooltipText}">
                <StackPanel>
                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource Brush9FB0BF}" FontSize="10" />
                    <TextBlock Text="{Binding TokensText}" Foreground="{Binding ValueBrush}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DailyTokenTotalTemplate">
            <Border Background="{DynamicResource Brush19372F}" CornerRadius="7" Padding="7,6" Margin="0,0,5,0"
                    ToolTip="{Binding TooltipText}">
                <StackPanel>
                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource BrushA8C3BA}" FontSize="10" />
                    <TextBlock Text="{Binding TokensText}" Foreground="{Binding ValueBrush}"
                               FontSize="15" FontWeight="Bold" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CoverageText}" Foreground="{DynamicResource BrushA8C3BA}" FontSize="10"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AccountTemplate">
            <Border Background="{DynamicResource Brush111A23}" BorderBrush="{DynamicResource Brush2B3A49}" BorderThickness="1"
                    CornerRadius="14" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Cursor="Hand"
                                  Background="Transparent" Foreground="{DynamicResource BrushE6EDF3}" BorderThickness="0"
                                  AutomationProperties.Name="{DynamicResource L_ExpandAccount}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Brush17212C}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Brush48C5A9}" />
                                        <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource Brush9FB0BF}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▾" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="▸" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding IdentityTooltip}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PlanLabel}" Foreground="{Binding PlanAccentBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text=" · " Foreground="{DynamicResource BrushA9B7C5}" />
                                    <TextBlock Grid.Column="2" Text="{Binding WorkspaceText}"
                                               Foreground="{DynamicResource BrushA9B7C5}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="{Binding UpdatedText}" Foreground="{DynamicResource Brush8293A3}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <Button Grid.Column="1" Content="✎" Width="22" Height="22" Padding="0"
                            Margin="8,0,0,0" VerticalAlignment="Top"
                            Background="{DynamicResource Brush34495C}"
                            Foreground="{DynamicResource SecondaryButtonText}"
                            ToolTip="{DynamicResource L_EditAlias}"
                            AutomationProperties.Name="{DynamicResource L_EditAlias}"
                            Click="EditAliasButton_Click" />
                    <Grid Grid.Column="2" Margin="12,0,0,0" MinWidth="138">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource Brush73D8C2}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Row="1" Content="{Binding ResetCreditDetailedText}"
                                Style="{StaticResource ResetCreditButtonStyle}"
                                Background="{Binding ResetCreditBackground}"
                                BorderBrush="{Binding ResetCreditBorder}"
                                Foreground="{Binding ResetCreditForeground}" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0" ToolTip="{Binding ResetCreditTooltip}"
                                AutomationProperties.Name="{Binding ResetCreditDetailedText}"
                                Click="ResetCreditsButton_Click" />
                    </Grid>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Windows}" ItemTemplate="{StaticResource WindowTemplate}"
                                  Margin="22,8,0,0"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                    <Border Background="{DynamicResource Brush0F1720}" CornerRadius="9" Padding="10,8" Margin="22,6,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L_AccountDailyTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushD4DFE8}" />
                                <TextBlock Grid.Column="1" Text="{Binding DailyTokenUpdatedText}"
                                           Foreground="{DynamicResource Brush8293A3}" FontSize="10" Margin="8,0,0,0" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DailyTokenRows}"
                                          ItemTemplate="{StaticResource DailyTokenAccountTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GridQuotaTemplate">
            <StackPanel Margin="0,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ShortLabel}" Foreground="{DynamicResource Brush9FB0BF}" FontSize="12"
                               VerticalAlignment="Center" ToolTip="{Binding Label}" />
                    <ProgressBar Grid.Column="1" Style="{StaticResource AvailabilityBarStyle}"
                                 Value="{Binding AvailablePercent, Mode=OneWay}"
                                 Foreground="{Binding AvailabilityBrush}" Margin="8,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="{Binding TooltipText}" />
                    <TextBlock Grid.Column="2" Text="{Binding AvailableText}"
                               Foreground="{Binding AvailabilityBrush}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ResetText}" Foreground="{DynamicResource Brush8293A3}" FontSize="10"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding CountdownText}" Foreground="{DynamicResource Brush9FB0BF}"
                               FontSize="10" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CountdownText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="GridAccountTemplate">
            <Border Width="292" Height="180" Background="{DynamicResource Brush111A23}" BorderBrush="{DynamicResource Brush2B3A49}"
                    BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="48" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="16" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding IdentityTooltip}" />
                        <Button Grid.Column="1" Content="{Binding ResetCreditGridText}"
                                Style="{StaticResource ResetCreditButtonStyle}"
                                Background="{Binding ResetCreditBackground}"
                                BorderBrush="{Binding ResetCreditBorder}"
                                Foreground="{Binding ResetCreditForeground}"
                                FontSize="10" Padding="4,1" Margin="5,0,0,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                ToolTip="{Binding ResetCreditTooltip}"
                                AutomationProperties.Name="{Binding ResetCreditGridText}"
                                Click="ResetCreditsButton_Click" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PlanLabel}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding PlanAccentBrush}" />
                            <TextBlock Grid.Column="1" Text=" · " FontSize="10" Foreground="{DynamicResource Brush9FB0BF}" />
                            <TextBlock Grid.Column="2" Text="{Binding WorkspaceText}" FontSize="10"
                                       Foreground="{DynamicResource Brush9FB0BF}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding StateText}"
                                   FontSize="10" Foreground="{DynamicResource Brush73D8C2}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="2" Grid.Column="1" Content="✎" Width="19" Height="18"
                                Padding="0" Margin="5,0,0,0" FontSize="10"
                                Background="{DynamicResource Brush34495C}"
                                Foreground="{DynamicResource SecondaryButtonText}"
                                ToolTip="{DynamicResource L_EditAlias}"
                                AutomationProperties.Name="{DynamicResource L_EditAlias}"
                                Click="EditAliasButton_Click" />
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource Brush2B3A49}" />
                    <ContentPresenter Grid.Row="2" Content="{Binding FiveHourQuota}"
                                      ContentTemplate="{StaticResource GridQuotaTemplate}" />
                    <Border Grid.Row="3" Background="{DynamicResource Brush2B3A49}" />
                    <ContentPresenter Grid.Row="4" Content="{Binding WeeklyQuota}"
                                      ContentTemplate="{StaticResource GridQuotaTemplate}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactQuotaTemplate">
            <Grid Margin="4,0,8,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="22" Height="22" HorizontalAlignment="Right"
                      Margin="0,0,7,0" ToolTip="{Binding TooltipText}"
                      AutomationProperties.Name="{Binding TooltipText}">
                    <Ellipse Width="18" Height="18" Fill="{DynamicResource Brush2B3944}" />
                    <Path Data="{Binding ClockElapsedGeometry}" Fill="{Binding ClockElapsedBrush}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Ellipse Width="19" Height="19" Stroke="{DynamicResource BrushAAB7C2}" StrokeThickness="1.2" />
                    <Line X1="11" Y1="4" X2="11" Y2="11" Stroke="{DynamicResource BrushE6EDF3}" StrokeThickness="1" />
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource BrushE6EDF3}" />
                </Grid>
                <ProgressBar Grid.Column="1" Style="{StaticResource AvailabilityBarStyle}" Height="7" Width="70"
                             Value="{Binding AvailablePercent, Mode=OneWay}"
                             Foreground="{Binding AvailabilityBrush}"
                             VerticalAlignment="Center" ToolTip="{Binding TooltipText}"
                             Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="2" Text="{Binding CompactAvailableText}"
                           Foreground="{Binding AvailabilityBrush}" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CompactAccountTemplate">
            <Border Height="49" Background="{DynamicResource Brush111A23}" BorderBrush="{DynamicResource Brush2B3A49}" BorderThickness="1"
                    CornerRadius="8" Padding="12,0" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44*" />
                        <ColumnDefinition Width="28*" />
                        <ColumnDefinition Width="28*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PlanTag" MinWidth="43" MaxWidth="110" Height="22"
                                CornerRadius="7" Padding="8,0"
                                Background="{Binding PlanBadgeBackground}"
                                BorderBrush="{Binding PlanBadgeBorder}" BorderThickness="1"
                                ToolTip="{Binding IdentityTooltip}">
                            <TextBlock Text="{Binding PlanLabel}" FontSize="10" FontWeight="Bold"
                                       Foreground="{Binding PlanBadgeForeground}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"
                                   ToolTip="{Binding IdentityTooltip}" />
                        <Button Grid.Column="2" Content="✎" Width="20" Height="20" Padding="0"
                                Margin="6,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource Brush34495C}"
                                Foreground="{DynamicResource SecondaryButtonText}"
                                ToolTip="{DynamicResource L_EditAlias}"
                                AutomationProperties.Name="{DynamicResource L_EditAlias}"
                                Click="EditAliasButton_Click" />
                        <Button Grid.Column="3" Content="{Binding ResetCreditCompactText}"
                                Style="{StaticResource ResetCreditButtonStyle}"
                                MinWidth="22" Height="20" Padding="5,0" Margin="6,0,0,0"
                                VerticalAlignment="Center" Background="{Binding ResetCreditBackground}"
                                BorderBrush="{Binding ResetCreditBorder}"
                                Foreground="{Binding ResetCreditForeground}"
                                FontSize="10" FontWeight="SemiBold"
                                ToolTip="{Binding ResetCreditTooltip}"
                                AutomationProperties.Name="{Binding ResetCreditTooltip}"
                                Click="ResetCreditsButton_Click" />
                    </Grid>
                    <ContentPresenter Grid.Column="1" Content="{Binding FiveHourQuota}"
                                      ContentTemplate="{StaticResource CompactQuotaTemplate}" />
                    <ContentPresenter Grid.Column="2" Content="{Binding WeeklyQuota}"
                                      ContentTemplate="{StaticResource CompactQuotaTemplate}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Text="Codex Quota Hub" FontSize="24" FontWeight="Bold" />
            <TextBlock x:Name="TitleDescription" Grid.Column="1"
                       Text="{DynamicResource L_Subtitle}"
                       Foreground="{DynamicResource Brush9FB0BF}" FontSize="11" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="CompactStatusText" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Right"
                       VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource Brush73D8C2}"
                       TextTrimming="CharacterEllipsis" MaxWidth="420" Margin="14,4,0,0" />
        </Grid>
        <Border x:Name="StatusBorder" Grid.Row="1" Background="{DynamicResource StatusSurface}" CornerRadius="10"
                Padding="14" Margin="0,0,0,15">
            <TextBlock x:Name="StatusText" Text="{DynamicResource L_Loading}" TextWrapping="Wrap" />
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="RefreshButton" Content="{DynamicResource L_Refresh}" Click="RefreshButton_Click" />
                    <Button x:Name="PauseButton" Content="{DynamicResource L_Pause}" Click="PauseButton_Click"
                            Background="{DynamicResource Brush34495C}" Foreground="{DynamicResource SecondaryButtonText}" />
                    <Button x:Name="SettingsButton" Content="{DynamicResource L_Settings}" Click="SettingsButton_Click"
                            Background="{DynamicResource Brush34495C}" Foreground="{DynamicResource SecondaryButtonText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource L_View}" Foreground="{DynamicResource Brush9FB0BF}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="DetailedViewButton" Content="{DynamicResource L_Detailed}" Click="DetailedViewButton_Click" />
                    <Button x:Name="GridViewButton" Content="Grid" Background="{DynamicResource Brush34495C}"
                            Click="GridViewButton_Click" />
                    <Button x:Name="CompactViewButton" Content="{DynamicResource L_Compact}" Background="{DynamicResource Brush34495C}"
                            Margin="0" Click="CompactViewButton_Click" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="IntervalText" Grid.Row="1" Foreground="{DynamicResource Brush9FB0BF}"
                       FontSize="12" Margin="0,12,0,0" />
        </Grid>
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="DetailedView" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource TotalSurface}" BorderBrush="{DynamicResource Brush315D50}" BorderThickness="1"
                            CornerRadius="12" Padding="13,11" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L_TotalTitle}" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{DynamicResource BrushE6EDF3}" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource L_RecentSourceDates}"
                                           Foreground="{DynamicResource BrushA8C3BA}" FontSize="10" />
                            </Grid>
                            <ItemsControl x:Name="DailyTokenTotals"
                                          ItemTemplate="{StaticResource DailyTokenTotalTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource L_TotalNote}"
                                       Foreground="{DynamicResource BrushA8C3BA}" FontSize="10" Margin="0,9,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="AccountList" ItemTemplate="{StaticResource AccountTemplate}" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="GridView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AccountGrid" ItemTemplate="{StaticResource GridAccountTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <Grid x:Name="CompactView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,0,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44*" />
                        <ColumnDefinition Width="28*" />
                        <ColumnDefinition Width="28*" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource L_Account}" Foreground="{DynamicResource Brush9FB0BF}" FontSize="11"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{DynamicResource L_ManualReset}" Foreground="{DynamicResource Brush9FB0BF}" FontSize="11"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{DynamicResource L_FiveHourAvailable}" Foreground="{DynamicResource Brush9FB0BF}" FontSize="11"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource L_SevenDayAvailable}" Foreground="{DynamicResource Brush9FB0BF}" FontSize="11"
                               HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CompactList" ItemTemplate="{StaticResource CompactAccountTemplate}" />
                </ScrollViewer>
            </Grid>
            <TextBlock x:Name="EmptyText" Text="{DynamicResource L_Empty}"
                       Foreground="{DynamicResource Brush9FB0BF}" FontSize="16" Margin="0,25" Visibility="Collapsed"
                       Panel.ZIndex="1" />
        </Grid>
    </Grid>
</Window>
